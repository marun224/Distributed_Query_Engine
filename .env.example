# Copy to `.env` and fill in. `.env` is gitignored; this file must never hold real secrets.
#
# Precedence (highest wins): Session.builder.config(...) > process env > .env > defaults.
# The ICETL_* keys are read by icetl (the coordinator *and* every worker); the ICEFLEET_*
# keys are icefleet's own. Workers read their own .env -- credentials never travel over
# the wire (PLAN decision 20).

# --- Catalog (coordinator only) ---------------------------------------------
ICETL_CATALOG_NAME=rest
ICETL_CATALOG_TYPE=rest
ICETL_CATALOG_URI=http://localhost:8182
ICETL_CATALOG_WAREHOUSE=s3://warehouse/
ICETL_DEFAULT_NAMESPACE=nyc

# --- Object store (MinIO) -- coordinator and workers -------------------------
ICETL_S3_ENDPOINT=http://localhost:9100
ICETL_S3_ACCESS_KEY_ID=<access-key>
ICETL_S3_SECRET_ACCESS_KEY=<secret-key>
ICETL_S3_REGION=us-east-1
ICETL_S3_PATH_STYLE_ACCESS=true

# --- icefleet -----------------------------------------------------------------
# local[N] spawns N workers on this machine; static://host:port,... names running ones.
ICEFLEET_MASTER=local[2]
# Where stage output lives: a directory (local[N] default is a temp dir) or s3://bucket/prefix.
ICEFLEET_EXCHANGE_LOCATION=s3://icefleet-shuffle/
# single-node | error -- what happens to a plan the stage planner cannot cut.
ICEFLEET_FALLBACK=single-node

# --- Integration suite --------------------------------------------------------
# Writes only here; refuses to run if it names a protected namespace.
ICEFLEET_IT_NAMESPACE=icefleet_it
ICEFLEET_IT_PROTECTED=nyc,amazon
